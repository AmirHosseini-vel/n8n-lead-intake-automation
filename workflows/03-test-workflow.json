{
  "name": "Test - Send Lead via Form",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Dental Clinic - Lead Test Form",
        "formDescription": "Use this form to send test lead data to the Main Lead Intake workflow. Leave fields empty or enter invalid values when testing validation.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "fieldName": "name",
              "placeholder": "e.g. Ali Rezaei"
            },
            {
              "fieldLabel": "Email",
              "fieldName": "email",
              "placeholder": "e.g. ali@example.com (you can leave this empty)"
            },
            {
              "fieldLabel": "Phone",
              "fieldName": "phone",
              "placeholder": "e.g. 09121234567"
            },
            {
              "fieldLabel": "Service",
              "fieldType": "dropdown",
              "fieldName": "service",
              "fieldOptions": {
                "values": [
                  {
                    "option": "implant"
                  },
                  {
                    "option": "teeth whitening"
                  },
                  {
                    "option": "dental checkup"
                  },
                  {
                    "option": "other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "fieldName": "message",
              "placeholder": "Write a short message (optional)"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Send Test Lead",
          "path": "test-lead-form",
          "ignoreBots": true
        }
      },
      "id": "22655e8b-fb41-46e2-8c52-ce8269f699d0",
      "name": "Form Trigger - Enter Test Lead",
