        "sendHeaders": false,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { name: $json.name ?? '', email: $json.email ?? '', phone: $json.phone ?? '', service: $json.service ?? '', message: $json.message ?? '' } }}",
        "options": {}
